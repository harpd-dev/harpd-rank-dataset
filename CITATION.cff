    website: "https://harpd.com/"
    email: "harpdsupport@gmail.com"
repository-code: "https://github.com/harpd-dev/harpd-rank-dataset"
url: "https://harpd.com/data/"
license: CC-BY-4.0
keywords:
  - AI products
  - software directory
  - product rankings
  - leaderboard
  - open dataset
  - GEO
version: "2026-08"
date-released: "2026-09-09"
identifiers:
